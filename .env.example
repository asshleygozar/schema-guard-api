DATABASE_URL=<your_database_url> # I use neon for this so I input neon database url with postgresql 
DIRECT_URL=<your_direct_url> # direct url is for alembic so it can connect to your database to make schema changes
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
SESSION_COOKIE_DOMAIN=
APP_STAGE=<mode> # [development,production,testing] default development

# GITHUB VARIABLES SPECIFIC
GITHUB_CLIENT_ID=<your_github_client_id>
GITHUB_CLIENT_SECRET=<your_github_client_secret>
GITHUB_CALLBACK_URL=<your_github_callback_url>

# SESSION VARIABLES SPECIFIC
SESSION_SECRET=<32_characters_random_session_secret>
